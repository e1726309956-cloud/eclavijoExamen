<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eclavijoExamen.Views.Login"
             Title="Login">
    <VerticalStackLayout
        Spacing="10"
        Padding="20">

        <Image 
            Source="logo.png"
            HeightRequest="150"
            WidthRequest="150"
            HorizontalOptions="Center" />
        
        <Label Text="SISTEMA DE GIMNASIO"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="Purple"
               HorizontalOptions="Center"/>

        <Grid RowSpacing="10"
              ColumnSpacing="10">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Label Text="Usuario:"
                   Grid.Row="0"
                   Grid.Column="0"
                  />

            <Entry x:Name="txtUsuario"
                   Placeholder="Ingrese usuario"
                   Grid.Row="0"
                   Grid.Column="1"
                   />

            <Label Text="Contraseña:"
                   Grid.Row="1"
                   Grid.Column="0"
                   />

            <Entry x:Name="txtContrasena"
                   Placeholder="Ingrese contraseña"
                   IsPassword="True"
                   Grid.Row="1"
                   Grid.Column="1"
                   />
            <Button x:Name="btnIniciarSesion"
                    Text="Iniciar Sesión"
                    Style="{StaticResource BotonGlobal}"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"/>

        </Grid>

        <Button x:Name="btnAcerca"
                Text="Acerca de"
                Style="{StaticResource BotonGlobal}"
                Clicked="btnAcerca_Clicked"/>





    </VerticalStackLayout>
</ContentPage>